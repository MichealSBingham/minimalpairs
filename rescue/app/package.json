{
  "name": "minimalpairs-rescue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/build-dark-theme.mjs && node scripts/prepare-content.mjs && astro check && astro build",
    "check": "astro check",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "deploy:preview": "node scripts/deploy-preview.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "astro": "^7.3.5",
    "firebase": "^12.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase-tools": "^15.31.0",
    "typescript": "^5.0.0"
  }
}
