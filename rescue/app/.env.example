SITE_URL=https://minimalpairs.co
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# Only set true after real checkout and existing entitlements are verified.
PUBLIC_BILLING_ENABLED=false
# The reviewed API origin only, with no path or trailing slash. No payment links.
PUBLIC_BILLING_API_ORIGIN=
# New sales can be paused while existing memberships retain portal access.
PUBLIC_BILLING_CHECKOUT_ENABLED=false
# Preview builds stay out of search; switch for the verified production build.
PUBLIC_SITE_INDEXABLE=false
# Optional analytics loads only after visitor opt-in. Preview events are debug events.
PUBLIC_ANALYTICS_ENABLED=false
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_MEASUREMENT_ENVIRONMENT=preview
PUBLIC_EMAIL_PASSWORD_ENABLED=false
PUBLIC_AUTH_EMAILS_ENABLED=false
