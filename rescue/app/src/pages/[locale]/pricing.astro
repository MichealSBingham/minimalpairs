---
import Base from '../../layouts/Base.astro';
import { Header, Footer } from '../../components/ui';
import MembershipPanel from '../../components/MembershipPanel';
import { commerce, commerceLocales } from '../../lib/commerce-i18n';
import '../../styles/pricing.css';
export function getStaticPaths() { return commerceLocales.filter(locale => locale !== 'en').map(locale => ({ params: { locale } })); }
const locale = Astro.params.locale!;
const t = commerce(locale);
---
<Base title={`${t('plans')} | MinimalPairs`} description={t('plansDescription')} locale={locale}>
<Header locale={locale} />
<main class="pricing-page"><header class="pricing-hero"><h1>{t('hero')}<br /><em>{t('heroSub')}</em></h1><p>{t('heroBody')}</p><div class="pricing-proof"><span>{t('nine')}</span><span>{t('audioOnly')}</span></div></header>
<MembershipPanel storefront locale={locale} client:load />
<section class="pricing-faq"><h2>{t('faq')}</h2><details><summary>{t('free')}</summary><p>{t('freeDiagnostic')}. {t('freeExercises')}. {t('freeUnlimited')}. {t('noCard')}</p></details><details><summary>{t('premium')}</summary><p>{t('allExercises')}. {t('unlimited')}. {t('feedback')}.</p></details><details><summary>{t('cancelQuestion')}</summary><p>{t('secure')}</p></details><details><summary>{t('lifetime')}</summary><p>{t('restoreBody')}</p><a href={`/${locale}/account#account-sign-in`}>{t('restore')} →</a></details></section></main><Footer locale={locale} />
</Base>
