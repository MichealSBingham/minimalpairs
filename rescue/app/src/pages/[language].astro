---
import ListeningDemo from '../components/ListeningDemo';
import {challenges} from '../lib/growth-content';
import '../styles/growth.css';
import Base from '../layouts/Base.astro';
import { Header, Footer, Icon } from '../components/ui';
import { getGuideLanguages as getLanguages, getPracticeLanguages, slugFor } from '../lib/content';
import { guideAudioStatus } from '../lib/guide-audio-status';
import { absoluteUrl, pairCount, practiceUrl, readingFor, safeJsonLd } from '../lib/seo';
import type { Language } from '../lib/types';
import '../styles/editorial.css';
import '../styles/language-redesign.css';

export function getStaticPaths() {
  return getLanguages().map(language => ({ params: { language: slugFor(language) }, props: { language } }));
}
const { language } = Astro.props as { language: Language };
const count = pairCount(language);
const lessonIds = new Set(getPracticeLanguages().find(l => l.id === language.id)?.contrasts.map(c => c.id) || []);
const audioByContrast = new Map(language.contrasts.map(contrast => [contrast.id, guideAudioStatus(language.id, contrast)]));
const deviceOnlyCount = [...audioByContrast.values()].filter(status => !status.hasCachedAudio).length;
const languages = [language, ...getLanguages().filter(item => item.id !== language.id)];
const entranceCopy: Record<string, { intro: string; description: string }> = {
  fr: { intro: 'Hear the difference between French words like tu and tout. Explore vowels, nasal vowels and consonants with audio examples, then practice the sounds you find hardest.', description: 'French minimal pairs with audio, IPA and word examples. Compare tu vs tout, nasal vowels and more. Take a free listening diagnostic to find your next lesson.' },
  en: { intro: 'Hear the difference between English words like ship and sheep. Explore vowel and consonant contrasts with audio examples, then practice the sounds you find hardest.', description: 'English minimal pairs with audio, IPA and word examples. Explore American English vowel and consonant contrasts, then try a free listening diagnostic.' },
};
entranceCopy.zh={intro:'Hear Mandarin tones in real words. Compare a level first tone with a falling fourth tone, then explore the tone pairs and consonants you find difficult.',description:'Mandarin Chinese minimal pairs with audio: practice tone differences, hear word examples and test your listening. Start with Tone 1 vs Tone 4, then explore more contrasts.'};
entranceCopy.ja={intro:'Hear the differences that change Japanese words: short and long vowels, single and doubled consonants, and other sound contrasts. Try a listening round before choosing your next lesson.',description:'Japanese minimal pairs and sound contrasts with audio. Practice short and long vowels, doubled consonants and listening discrimination with different words and voices.'};
const entryDemos:Record<string,{contrast:string;title:string;body:string}>= {
 fr:{contrast:'fr-u-y',title:'Can you hear French u and ou?',body:'Tu and tout differ in one vowel. Listen to the examples, then match the same vowel in a new word.'},
 zh:{contrast:'zh-tone-1-4',title:'Same syllable. Different tone. Can you hear it?',body:'Mandarin mā (妈, mother) has a high, level tone. Mà (骂, scold) has a falling tone. Match the tone across different words, without the spelling giving it away.'},
 ja:{contrast:'ja-i-length',title:'Can you hear a short i and a long ī?',body:'Japanese vowel length matters. Compare the two vowel categories, then hear whether a new word contains the short or long vowel.'}
};
const entryDemo=entryDemos[language.id],demoLanguage=getPracticeLanguages().find(l=>l.id===language.id);
const entrance = entranceCopy[language.id];
const learnerTitles: Record<string, string> = {fr:'Hear French u vs ou: Listening Practice & Minimal Pairs',en:'Hear Ship vs Sheep: English Listening Practice & Minimal Pairs',ja:'Japanese Long Vowel Listening Practice & Minimal Pairs',zh:'Mandarin Tone Listening Practice & Minimal Pairs'};
const learnerHeading: Record<string, string> = {fr:'Hear the difference in French.',en:'Hear the difference in English.',ja:'Hear short and long Japanese sounds.',zh:'Learn to hear Mandarin tone differences.'};
const description = entrance?.description || `${language.name} listening practice with ${count} word pairs, IPA, meanings and focused sound guides. Explore ${language.dialect.toLowerCase()} one contrast at a time.`;
const url = absoluteUrl(`/${slugFor(language)}`);
const schema = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: `${language.name} minimal pairs`, description, url, inLanguage: 'en', hasPart: language.contrasts.map(contrast => ({ '@type': 'LearningResource', name: contrast.label, url: absoluteUrl(`/learn/${contrast.id}`), learningResourceType: 'Listening practice guide' })) };
---
<Base title={`${learnerTitles[language.id] || `${language.name} Listening Practice & Minimal Pairs`} | MinimalPairs`} description={description}>
  <Header />
  <main class="ed-page language-chooser">
    <div class="ed-wrap">
      <nav class="ed-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>{language.name}</span></nav>
      <nav class="language-chooser-tabs" aria-label="Choose a language">
        {languages.map(item => <a href={`/${slugFor(item)}`} aria-current={item.id === language.id ? 'page' : undefined}>{item.name}</a>)}
      </nav>
      <section class="language-chooser-heading" aria-labelledby="language-title">
        <p class="ed-eyebrow">MINIMAL PAIRS · LISTENING PRACTICE</p>
        <h1 id="language-title">{learnerHeading[language.id] || `Hear the difference in ${language.name}.`}</h1>
        <p class="ed-lede">{entrance?.intro || 'Start with a difference you find hard to hear. Words stay hidden during practice until you choose to show them.'}</p>
        <div class="language-chooser-meta"><span>{language.dialect}</span><span>{language.contrasts.length} sound contrasts</span></div>
        {lessonIds.size > 0 && <p><a class="ed-text-link" href={`/diagnostic/${language.id}`}>Find the sounds you find hard to hear <Icon name="arrow" size={18} /></a></p>}
        <p class="language-chooser-note">{lessonIds.size > 0 ? 'Take a listening test or choose a sound below. You don’t need to read IPA to start.' : 'Explore the sound contrasts and word examples below.'}</p>

      </section>

      {['en','fr'].includes(language.id) && <section class="growth-related"><h2>Try a quick listening challenge.</h2><div class="growth-links">{challenges.filter(c=>c.language===language.id).map(c=><a href={`/challenge/${c.slug}`}>{c.title}</a>)}</div><p><a href="/resources/minimal-pairs-after-fluent-forever">Read Fluent Forever? Start practicing →</a> · <a href="/resources/minimal-pairs-without-anki">Practice without building a deck →</a></p></section>}

      {entryDemo && demoLanguage && <section class="growth-grid" aria-label="Try a listening exercise"><div><p class="ed-eyebrow">START WITH A LISTEN</p><h2>{entryDemo.title}</h2><p>{entryDemo.body}</p><p>Hear different words and voices. After your answer, the matching sounds replay so you can compare them.</p><div class="growth-links"><a href={`/diagnostic/${language.id}`}>Find which sounds to practice →</a><a href={`/learn/${entryDemo.contrast}`}>Hear the word examples →</a></div></div><ListeningDemo client:visible language={demoLanguage} contrastId={entryDemo.contrast}/></section>}

      {language.id === 'fr' && <p class="growth-related"><a href="/resources/read-french-but-cant-understand">Can read French but miss the words when listening? Try this →</a></p>}
      <section class="language-chooser-catalog" aria-label={`${language.name} sound contrasts`}>
        <div class="language-contrast-grid">{language.contrasts.map(contrast => <article class="language-contrast-card">
          <div class="language-contrast-main">
            <h2 class:list={['language-contrast-sounds', { 'has-feature-label': contrast.phonemes.some(phoneme => phoneme.includes(' ')) }]} aria-label={contrast.label}>{contrast.phonemes.map((phoneme, index) => <>{index > 0 && <span class="language-contrast-vs" aria-hidden="true">vs</span>}<span class={index === 0 ? 'sound-a' : 'sound-b'}>{phoneme.includes(' ') ? phoneme : `/${phoneme}/`}</span></>)}</h2>
            <p class="language-contrast-examples" lang={language.locale}>{contrast.pairs[0].words.map((word, index) => <>{index > 0 && <span class="example-separator" aria-hidden="true"> · </span>}<span>{word.text}{readingFor(word) && <small>{readingFor(word)}</small>}</span></>)}</p>
          </div>
          <a class="language-contrast-drill" href={lessonIds.has(contrast.id) ? practiceUrl(language, contrast) : '/practice'} aria-label={lessonIds.has(contrast.id) ? `Practice ${contrast.label}` : 'Explore listening lessons'}>{lessonIds.has(contrast.id) ? 'Practice' : 'Lessons'} <Icon name="arrow" size={18} /></a>
          <p class="language-contrast-description">{contrast.description}</p>
          <div class="language-contrast-footer"><a class="sound-guide-link" href={`/learn/${contrast.id}`} aria-label={`Read the guide to ${contrast.label}`}>Sound guide <Icon name="arrow" size={14} /></a></div>
        </article>)}</div>
      </section>

      <section class="ed-explainer ed-section">
        <div><p class="ed-eyebrow">A CLOSER LISTEN</p><h2>What is a<br />minimal pair?</h2></div>
        <div><p>Two words form a minimal pair when one sound difference changes the word. Keeping the surrounding sounds the same gives you a specific difference to listen for.</p><p>Some lessons focus on tone or word stress instead of a single consonant or vowel. We label those separately, so you know what each exercise is testing.</p><p>In the exercise, listen to A and B, then a different word X. Choose the reference that shares the target sound, tone, stress or consonant feature. Words and IPA stay hidden unless you enable text hints, including after answering; you can replay the audio whenever you need it.</p><a class="ed-text-link" href="/method">Read about the learning approach <Icon name="arrow" size={16} /></a></div>
      </section>


    </div>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={safeJsonLd(schema)} />
</Base>
