---
import Base from '../layouts/Base.astro';
import { Header, Footer } from '../components/ui';
import MembershipPreview from '../components/MembershipPreview';
import { getPracticeLanguages } from '../lib/content';
import '../styles/business.css';
---
<Base title="Membership preview — MinimalPairs" description="Review the proposed free and paid listening experience." noindex>
 <Header/><main class="editorial-wrap"><p class="eyebrow">PLAN THE MEMBERSHIP</p><h1>One library. A clearer ear.</h1><p class="editorial-lede">Compare free, monthly, annual and existing lifetime access before launch.</p><MembershipPreview languages={getPracticeLanguages()} client:load/></main><Footer/>
</Base>
<style>select{font:inherit;padding:10px;margin:12px;border:1px solid #ccd5ca;border-radius:8px;background:white}</style>
