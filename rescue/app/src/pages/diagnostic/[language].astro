---
import Base from '../../layouts/Base.astro';
import DiagnosticLanding from '../../components/DiagnosticLanding.astro';
import {getPracticeLanguages} from '../../lib/content';
import {diagnosticDiscovery} from '../../lib/diagnostic-discovery';
import {diagnosticCopy} from '../../lib/diagnostic-i18n';
export function getStaticPaths(){return getPracticeLanguages().map(language=>({params:{language:language.id},props:{language}}));}
const {language}=Astro.props,t=diagnosticCopy('en'),discovery=diagnosticDiscovery('en');
---
<Base title={`Free ${language.name} Listening Test · Minimal Pairs | MinimalPairs`} description={`${language.name}: ${discovery.title}. ${t.resultsBody}`}><DiagnosticLanding language={language}/></Base>
