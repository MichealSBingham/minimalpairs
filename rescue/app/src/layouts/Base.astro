---
import '../styles/global.css';
import '../styles/product-redesign.css';
import AnalyticsChoice from '../components/AnalyticsChoice';
interface Props { title: string; description: string; noindex?: boolean; analytics?: boolean; }
const { title, description, noindex = false, analytics = true } = Astro.props;
const base = import.meta.env.SITE_URL || 'https://minimalpairs.co';
const canonical = new URL(Astro.url.pathname, base).toString();
const indexable = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true' && !noindex;
const measurementId = analytics && import.meta.env.PUBLIC_ANALYTICS_ENABLED === 'true' && !Astro.url.pathname.startsWith('/auth/') ? import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '' : '';
const measurementEnvironment = import.meta.env.PUBLIC_MEASUREMENT_ENVIRONMENT === 'production' ? 'production' : 'preview';
---
<!doctype html>
<html lang="en" data-measurement-id={measurementId} data-measurement-environment={measurementEnvironment}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee3" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MinimalPairs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body><slot />{measurementId && <AnalyticsChoice client:load />}</body>
</html>
