---
import {Header,Footer} from './ui';
import type {Language} from '../lib/types';
import {diagnosticCopy} from '../lib/diagnostic-i18n';
import {diagnosticShortCopy} from '../lib/diagnostic-short-copy';
import {selectDiagnosticContrasts,DIAGNOSTIC_ROUNDS_PER_GROUP} from '../lib/diagnostic-plan';
import DiagnosticPreview from './DiagnosticPreview';
import {localPath,type Locale} from '../lib/locales';
import {localizedLanguage,localizedSound,type PublicLocale} from '../lib/localized-public';
import {slugFor} from '../lib/content';
interface Props {language:Language;locale?:Locale}
const {language,locale='en'}=Astro.props;
const t=diagnosticCopy(locale),name=locale==='en'?language.name:localizedLanguage(language.id,locale as PublicLocale);
const short=diagnosticShortCopy(locale),contrasts=selectDiagnosticContrasts(language.contrasts,language.id);
const start=`${localPath(locale,'/practice')}?language=${language.id}&session=diagnostic`;
---
<Header locale={locale}/>
<main class="diagnostic-page">
  <div class="diagnostic-hero"><header><p class="eyebrow">{name} · {t.eyebrow}</p><h1>{t.title}</h1><p class="intro">{short.intro}</p><div class="facts"><span>{contrasts.length} {t.coverage}</span><span>{contrasts.length*DIAGNOSTIC_ROUNDS_PER_GROUP} {t.rounds}</span></div><a class="start" href={start}>{short.start} <span aria-hidden="true">→</span></a><p class="scope">{short.scope}</p></header><DiagnosticPreview language={language} locale={locale}/></div>
  <section class="steps"><h2>{t.how}</h2><ol>{t.steps.map((step,i)=><li><span>{i+1}</span>{step}</li>)}</ol></section>
  <section class="benefits"><article><h2>{t.results}</h2><p>{t.resultsBody}</p></article><article><h2>{t.practice}</h2><p>{t.practiceBody}</p></article></section>
  <section><h2>{t.examples}</h2><div class="sound-grid">{contrasts.map(c=><a href={localPath(locale,`/learn/${c.id}`)}>{c.phonemes.map((sound,i)=><>{i>0&&<span class="versus"> ↔ </span>}<span>{locale==='en'?(sound.includes(' ')?sound:`/${sound}/`):localizedSound(sound,locale as PublicLocale)}</span></>)}</a>)}</div><a class="browse" href={localPath(locale,`/${slugFor(language)}`)}>{t.browse} →</a></section>
</main>
<Footer locale={locale}/>
<style>
.diagnostic-page{max-width:1080px;padding:64px 24px 80px;margin:auto}.diagnostic-hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:48px;align-items:center}.diagnostic-page header{max-width:800px}.eyebrow{text-transform:uppercase;font-size:.78rem;letter-spacing:.12em;color:#66725d}.diagnostic-page h1{font-family:Georgia,serif;font-size:clamp(2.6rem,4.2vw,3.6rem);line-height:1.1;margin:20px 0}.intro{font-size:1.2rem;max-width:670px;line-height:1.7;color:#625f56}.facts{display:flex;gap:12px;flex-wrap:wrap;margin:24px 0}.facts span{border:1px solid #ded7c8;padding:8px 13px;border-radius:30px;font-size:.9rem}.start{display:inline-flex;gap:22px;align-items:center;padding:17px 23px;background:#24231d;color:white;text-decoration:none;border-radius:5px}.diagnostic-page section{margin-top:54px}.diagnostic-page h2{font-family:Georgia,serif;font-size:1.8rem;font-weight:400}.steps ol{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;list-style:none;padding:0}.steps li{display:flex;align-items:center;gap:15px;line-height:1.5}.steps li>span{border:1px solid #aebaa4;border-radius:50%;min-width:38px;height:38px;display:grid;place-items:center;color:#4e6548}.benefits{display:grid;grid-template-columns:1fr 1fr;gap:24px}.benefits article{border:1px solid #ded7c8;background:#faf8f1;padding:24px;border-radius:8px}.benefits h2{margin:0 0 12px}.benefits p,.scope{line-height:1.7;color:#625f56}.sound-grid{display:flex;flex-wrap:wrap;gap:12px}.sound-grid a{border:1px solid #ded7c8;border-radius:7px;padding:13px 17px;text-decoration:none;color:#2d5584;background:#faf8f1}.sound-grid a:hover{border-color:#2d5584}.versus{color:#8d877c}.browse{color:#2d5584}.scope{font-size:.92rem;margin-top:26px}a:focus-visible{outline:3px solid #2d5584;outline-offset:4px}@media(max-width:850px){.diagnostic-hero{grid-template-columns:1fr;gap:32px}}@media(max-width:620px){.diagnostic-page{padding:36px 20px 60px}.steps ol,.benefits{grid-template-columns:1fr}.steps ol{gap:16px}}
</style>
