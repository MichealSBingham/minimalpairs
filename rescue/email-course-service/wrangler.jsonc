{
  "name": "minimalpairs-email-course",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUDIENCE",
        "class_name": "EmailAudience"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "EmailAudience"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "vars": {
    "BUYER_COLLECTOR_ENABLED": "true",
    "RECOVERY_COLLECTOR_ENABLED": "true",
    "RECOVERY_SENDING_ENABLED": "true",
    "RECOVERY_TEMPLATE_SHA256": "5d8a2933cafadc637987b590942ff18f4c32631138200919301307672fd97297",
    "BUYER_SENDING_ENABLED": "true",
    "BUYER_START_EPOCH": "1790812800",
    "INTAKE_ENABLED": "true",
    "SENDING_ENABLED": "true",
    "PUBLIC_ORIGIN": "https://minimalpairs-email-course.sirmichealbingham.workers.dev",
    "FROM_ADDRESS": "Micheal at MinimalPairs <micheal@minimalpairs.co>",
    "DAILY_SEND_CAP": "20",
    "POSTAL_ADDRESS": "140 E 14th St, New York, NY 10003",
    "WEEKLY_SERIES_READY": "true",
    "LAUNCH_BANKS": "en-US-ga,fr",
    "APPROVED_BANKS": "en-US-ga,fr",
    "APPROVED_TEMPLATE_SHA256": "6d8a8cd4f7b4f5be28e77f607ecca092e761a032d843b7a720dacd09608bf0cc"
  },
  "services": [
    {
      "binding": "REPORTING",
      "service": "minimalpairs-audio-reports"
    },
    {
      "binding": "BILLING_PURCHASES",
      "service": "minimalpairs-billing"
    }
  ]
}
